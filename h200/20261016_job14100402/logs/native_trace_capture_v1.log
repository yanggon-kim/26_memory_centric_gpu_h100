SPINLOCK_HANDLING_MODE = 2 - Spinlock handling mode: 0=none, 1=fast_forward, 2=mark_region
SPINLOCK_ITER_TO_KEEP = 1 - Number of iterations to keep for spinlock handling
     ENABLE_WATCHDOG = 1 - Enable the watchdog to skip instructions between WARPSYNC.COLLECTIVE and its target instruction (inclusive)
        SKIP_TMA_MEM = 0 - Enable the skipping of TMA memory instructions
ALLOW_REG_VAL_TRACING = 1 - EXPERIMENTAL: Enable the tracing of register values. Trace format is not stable. Trace version is 6.
